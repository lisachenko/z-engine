<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         colors="true"
         bootstrap="./tests/bootstrap.php"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <testsuites>
        <testsuite name="Z-Engine Test Suite">
            <directory>./tests/</directory>
        </testsuite>
    </testsuites>
    <!--
      The `internal` group mutates engine state destructively and can segfault
      a release PHP build: it is excluded by default and runs separately via
      `composer test:internal` (ideally inside the debug PHP container).
      See AGENTS.md.
    -->
    <groups>
        <exclude>
            <group>performance</group>
            <group>internal</group>
        </exclude>
    </groups>
    <php>
        <!-- Verify FFI struct layouts against the C ground truth on every boot -->
        <env name="ZENGINE_STRICT_LAYOUT_CHECK" value="1"/>
        <!-- ffi.enable=preload|1 and zend.assertions=1 must be set in php.ini
             (or via `php -d` on the CLI) - they cannot be changed at runtime.
             See AGENTS.md and the CI workflow. -->
    </php>
    <source>
        <include>
            <directory>./src/</directory>
        </include>
    </source>
</phpunit>
