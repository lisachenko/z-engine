includes:
    - phpstan-baseline.neon

parameters:
    level: max
    phpVersion: 80400
    paths:
        - src
        - tests
        - tools/generator/lib
        - tools/generator/emit.php
        - tools/generator/generate.php
        - tools/generator/validate.php
    excludePaths:
        - tests/phpstan/specialization-class-stubs.php
    # Analysis-only declarations of the runtime-generated specialized classes and the
    # deliberately-undefined placeholder type (see the file header for the rationale)
    scanFiles:
        - tests/phpstan/specialization-class-stubs.php
    # FFI\CData is dynamically typed - the engine structs it wraps are only
    # known at runtime from the loaded header, so field/method access on CData
    # cannot be statically resolved. Scope the unavoidable ignores tightly to
    # CData/FFI so all non-FFI code is still held to level max.
    ignoreErrors:
        -
            identifier: property.notFound
            message: '#Access to an undefined property FFI\\CData::#'
        -
            identifier: method.nonObject
            message: '#Cannot call method \w+\(\) on FFI\\CData#'
        -
            identifier: property.nonObject
            message: '#Cannot access property \S+ on FFI\\CData#'
        # C arrays and pointers are indexed through the same CData handles
        -
            identifier: offsetAccess.nonOffsetAccessible
            message: '#Cannot access offset .+ on FFI\\CData#'
        # Core::call()/Core::new() proxy arbitrary engine functions via __call
        -
            identifier: method.notFound
            message: '#Call to an undefined method FFI::#'
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    # Named engine-struct shapes (see AGENTS.md "Engine structs are typed by shape").
    # Internal helpers that return CData declare these aliases in their @return tag,
    # so the narrowing lives in one place (System\EngineStructs) instead of per call
    # site. FFI\CData is final, so the aliases cannot intersect it: they intersect
    # stdClass instead, which keeps every shape property readable AND writable for
    # the analysis while the runtime value stays the CData handle. Keep the raw
    # handle in scope for FFI hand-offs (Core::addr()/memcpy()/cast()); use the
    # shaped view for field access. Each alias lists exactly the properties z-engine
    # reads or writes through FFI; pointer-to-struct fields stay plain
    # `FFI\CData|null` and are re-shaped at their read sites.
    typeAliases:
        ZendFunctionShape: 'stdClass&object{type: int, common: ZendFunctionCommonShape, op_array: ZendOpArrayShape}'
        ZendFunctionCommonShape: 'stdClass&object{function_name: FFI\CData|null, scope: FFI\CData|null, prototype: FFI\CData|null, fn_flags: int, num_args: int, arg_info: FFI\CData|null, attributes: FFI\CData|null}'
        ZendOpArrayShape: 'stdClass&object{fn_flags: int, refcount: FFI\CData|null, cache_size: int, run_time_cache__ptr: FFI\CData|null, static_variables: FFI\CData|null, static_variables_ptr__ptr: FFI\CData|null, function_name: FFI\CData|null, opcodes: FFI\CData, literals: FFI\CData|null, last: int, last_var: int, last_literal: int, T: int, num_args: int, required_num_args: int}'
        ZendClassEntryShape: 'stdClass&object{type: string, ce_flags: int, parent: FFI\CData|null, num_interfaces: int, interfaces: FFI\CData|null, function_table: FFI\CData, constants_table: FFI\CData, properties_info: FFI\CData, default_properties_table: FFI\CData|null, default_static_members_table: FFI\CData|null}'
        ZendClassConstantShape: 'stdClass&object{value: FFI\CData, ce: FFI\CData, doc_comment: FFI\CData|null, attributes: FFI\CData|null}'
        ZvalShape: 'stdClass&object{u1: stdClass&object{v: stdClass&object{type: int}, type_info: int}, u2: stdClass&object{constant_flags: int}, value: stdClass&object{lval: int, dval: float, str: FFI\CData, ptr: FFI\CData|null}}'
        ZendPropertyInfoShape: 'stdClass&object{flags: int, offset: int, ce: FFI\CData, type: stdClass&object{type_mask: int}}'
        ZendHashTableShape: 'stdClass&object{gc: stdClass&object{refcount: int, u: stdClass&object{type_info: int}}}'
        ZendClosureShape: 'stdClass&object{func: FFI\CData}'
